[TEMPLATE]
# PostgreSQL
POSTGRES_USER=reseed
POSTGRES_PASSWORD=reseed
POSTGRES_DB=reseed
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Maximo de conexiones del pool por instancia. En serverless conviene bajo
# (Aiven limita las conexiones totales); ver src/database/postgres-pool.ts.
POSTGRES_POOL_MAX=3

# MongoDB
MONGO_USER=reseed
MONGO_PASSWORD=reseed
MONGO_DB=reseed
MONGO_PORT=27017

# JWT (cambiar en produccion)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Servidor
PORT=3000

# URL publica de la plataforma; se usa en los botones de los correos
APP_URL=http://localhost:3000

# Correo tecnico del "vendedor del sistema": la plataforma vendiendo materia
# prima. Se crea solo la primera vez que un admin publica materia prima. No es
# una cuenta de una persona: no tiene contrasena utilizable y no aparece en los
# listados del panel.
PLATFORM_SELLER_EMAIL=tienda@izeco.app

# Origenes permitidos para CORS (comma-separated). Vacio = reflejar cualquier
# origen (solo para desarrollo). En produccion, listar los dominios reales:
# CORS_ORIGINS=https://tudominio.com,https://admin.tudominio.com
CORS_ORIGINS=

# Rate limiting de login/register (5 intentos por minuto por defecto)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=5

# Pasarela de pagos (hoy solo existe "dummy", en sandbox)
PAYMENTS_GATEWAY=dummy

# Con la pasarela "dummy" la app resuelve el pago en su propio checkout
# (ruta /checkout/[id] del frontend) llamando a POST /payments/:id/sandbox.
# No se necesitan llaves de PSP; el endpoint queda deshabilitado con una pasarela real.

# ---------------------------------------------------------------------------
# NOTIFICACIONES POR CORREO (SMTP Gmail)
# ---------------------------------------------------------------------------
# 1. Activa la verificacion en dos pasos de la cuenta de Google.
# 2. Crea una "contraseña de aplicación" en:
#    https://myaccount.google.com/apppasswords
#    (16 caracteres, sin espacios). Esa clave va en SMTP_PASS.
#
# Si SMTP_USER o SMTP_PASS estan vacios, el sistema NO falla: guarda cada
# notificacion en la base de datos con estado "omitida" y sigue funcionando.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Reseed
SMTP_FROM_EMAIL=
# Cambia a false para cortar los envios sin borrar las credenciales
SMTP_ENABLED=true

# Verificacion del correo en el registro: se envia un codigo de 6 digitos y el
# usuario no recibe token hasta confirmarlo. Solo se aplica si el SMTP esta
# habilitado, porque sin correo no hay forma de entregar el codigo; en ese caso
# el registro sigue funcionando sin verificar. Pon false para saltartela.
REQUIRE_EMAIL_VERIFICATION=true

# Base de datos solo para scaffolding local fresco (nunca en produccion)
TYPEORM_SYNCHRONIZE=false
